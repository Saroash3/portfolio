# Copy to .env.local for local development. In Vercel, add the same keys under
# Project Settings -> Environment Variables. Never commit .env.local.

# Required for the contact form. Create one at https://resend.com/api-keys
RESEND_API_KEY=

# Where contact messages are delivered (defaults to the email in src/content/site.ts)
CONTACT_TO_EMAIL=

# Sender address. Must be on a domain you verified in Resend, e.g.
#   CONTACT_FROM_EMAIL="Portfolio <hello@yourdomain.com>"
# Leave empty to use Resend's test sender (onboarding@resend.dev), which only
# delivers to the email address of your own Resend account.
CONTACT_FROM_EMAIL=

# Your live URL, used for canonical links, Open Graph, sitemap and robots.
# Example: https://saroash-waseem.vercel.app
NEXT_PUBLIC_SITE_URL=
